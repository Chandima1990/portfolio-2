# Copy to .env (never commit .env) and fill in real values.

# Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Portfolio <contact@chandimae.com>".
# Falls back to onboarding@resend.dev when empty.
RESEND_FROM_EMAIL=
# Inbox that receives contact form messages
CONTACT_TO_EMAIL=emcc1990@gmail.com

# Optional Umami analytics (leave empty to disable)
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
